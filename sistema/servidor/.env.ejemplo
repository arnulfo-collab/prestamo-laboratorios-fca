# Copia este archivo como .env y llena los valores.
# .env nunca se sube al repositorio: contiene credenciales.

# Cadena de conexión a PostgreSQL.
# Local:  postgresql://postgres:TU_CONTRASENA@localhost:5432/prestamo_laboratorios
# Nube:   la que entrega el proveedor del plan gratuito
DATABASE_URL=postgresql://postgres:cambiame@localhost:5432/prestamo_laboratorios

# Pon true cuando la base esté en la nube y exija TLS.
BD_SSL=false

# Puerto en el que escucha el servidor.
PUERTO=3000

# Horas que dura una sesión antes de expirar.
HORAS_DE_SESION=8

# production activa la cookie segura (solo HTTPS).
NODE_ENV=development
